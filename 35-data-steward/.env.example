# Copy to .env (git-ignored). Never commit real values.
# Your seat login from the course team. It looks like an address but no mail is sent; it is only a username.
SEAT35_EMAIL=
# Each system has its own password. Paste them; they are long and have symbols.
SEAT35_PASSWORD_SURYODAYA=
SEAT35_PASSWORD_KEYSTONE=

# Model endpoint for local runs. The harness runner supplies its own OPENAI_* values.
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_MODEL=

# Optional: pin "today" so runs are reproducible (YYYY-MM-DD). Defaults to the real date.
AGENT_TODAY=
